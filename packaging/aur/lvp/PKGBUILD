# Maintainer: Liam Palmqvist <https://github.com/LiamPalmqvist>
pkgname=lvp
pkgver=0.2.1
pkgrel=1
pkgdesc="Media player built on VLC's engine with a redesigned interface"
arch=('x86_64' 'aarch64')
url="https://github.com/LiamPalmqvist/LVP"
license=('GPL-2.0-or-later')
# libvlc and the windowing and graphics libraries are loaded at runtime.
depends=('libgcc' 'glibc' 'hicolor-icon-theme' 'libvlc' 'vlc-plugins-all'
         'libxkbcommon' 'wayland' 'libx11' 'libxcursor' 'libxrandr' 'libxi'
         'vulkan-icd-loader' 'libglvnd')
makedepends=('cargo')
optdepends=('xdg-desktop-portal: file and folder pickers'
            'libnotify: desktop notifications'
            'xdg-utils: show a file in its folder')
# tools/build-linux.sh strips the binary, so a debug package would be empty.
options=('!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('9a255f189870b276d9b77901a3a38c6a19cc95e77a5a948d24cab553c4a2ce71')

prepare() {
  cd "LVP-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "LVP-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The release binary, the desktop entry and the icon, laid out in dist/ as
  # the Linux tarball has them.
  sh tools/build-linux.sh
}

package() {
  cd "LVP-$pkgver/dist/lvp-$pkgver-linux-$CARCH"
  install -Dm755 bin/lvp "$pkgdir/usr/bin/lvp"
  install -Dm644 share/applications/org.lvp.LVP.desktop -t "$pkgdir/usr/share/applications"
  install -Dm644 share/icons/hicolor/256x256/apps/lvp.png -t "$pkgdir/usr/share/icons/hicolor/256x256/apps"
}
